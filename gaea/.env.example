# ==========================================
# Gaea 部署环境变量配置
# 复制此文件为 .env 并填写实际值
# ==========================================

# 数据库密码（必填）
POSTGRES_PASSWORD=your_secure_password_here

# JWT 密钥（必填，建议使用 openssl rand -hex 32 生成）
SECRET_KEY=your_jwt_secret_key_here

# 阿里云听悟 ASR 配置
DASHSCOPE_API_KEY=
TINGWU_APP_ID=

# 字节跳动豆包模型配置
DOUBAO_API_KEY=

# 阿里云 OSS 配置
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
